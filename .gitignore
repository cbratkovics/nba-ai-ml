# dbt seeds are committed CSV; the warehouse loader's copies and dbt's own outputs are not.
!dbt/seeds/*.csv
!dbt/package-lock.yml
# The owner's ~/.gitignore_global ignores *.sql machine-wide; the dbt project is SQL.
!dbt/**/*.sql

